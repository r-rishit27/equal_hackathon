# Point this to your EC2 backend domain after deployment
# Also set this in Amplify Console → App Settings → Environment Variables
VITE_API_URL=https://equal.collabup.co.in

# Nova reconciliation service (systemd unit equal-nova on the EC2 box, proxied by nginx)
VITE_NOVA_RECONCILIATION_API_URL=https://equal.collabup.co.in/nova
