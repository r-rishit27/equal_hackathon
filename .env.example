# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DB_HOST=ep-xxxx.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=
DB_SSL=require
# Set either connection URL. DB_URL takes precedence over DEV_DB_URL.
DB_URL=
DEV_DB_URL=

# ─── OCR ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# OCR read path: auto (text layer, vision fallback) | text | vision. Restart to apply.
# 'auto' is more accurate on digital PDFs; 'vision' is the old always-rasterise behaviour.
OCR_TO_USE=auto
OPENAI_OCR_MODEL=gpt-4o
# Text-layer adequacy thresholds (see config.py)
OCR_TEXT_MIN_CHARS_PER_PAGE=100
OCR_TEXT_MIN_CHARS_ANY_PAGE=20
SARVAM_API_KEY=
POPPLER_PATH=          # macOS: /opt/homebrew/bin  |  Windows: C:\poppler\bin

# ─── Sandbox.co.in KYB / GST ─────────────────────────────────────────────────
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_BASE_URL=https://api.sandbox.co.in

# ─── Email (SMTP / IMAP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=456
SMTP_USER=
SMTP_PASSWORD=
SMTP_ADMIN_EMAIL=
IMAP_HOST=imap.gmail.com

# ─── Auth ─────────────────────────────────────────────────────────────────────
APPROVAL_SECRET=change-me

# ─── Tally Prime ─────────────────────────────────────────────────────────────
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY_NAME=

# ─── Tally Sync Settings ──────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
TALLY_PULL_DAYS=30
TALLY_THREAD_POOL=4
DEFAULT_SALES_LEDGER=Sales A/c
DEFAULT_TAX_LEDGER=
DEFAULT_BANK_LEDGER=Cash

# ─── Pipeline Tuning ─────────────────────────────────────────────────────────
API_SYNC_BATCH=50
WEBHOOK_BATCH=50
UPLOAD_BATCH=10
PROMOTION_BATCH=100
APPROVAL_BATCH=50
POLL_INTERVAL_S=5
AUTO_APPROVE_THRESHOLD=50000

# ─── Multi-tenancy ────────────────────────────────────────────────────────────
TENANT_ID=
BACKEND_TENANT_ID=
TENANT_NAME=
TENANT_GSTN=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Export these for Vite or place them in frontend/.env.local (see agent.md).
VITE_API_URL=http://127.0.0.1:8014
VITE_NOVA_RECONCILIATION_API_URL=http://127.0.0.1:8100

# Tenants this pipeline instance processes (comma-separated; empty = ALL tenants).
# Was hardcoded in main.py; a new tenant got no background processing until it was
# edited and redeployed. Set per environment.
PIPELINE_TENANT_ID=

# Platform (ops) admin — signs /api/admin/* tokens. MUST be set, MUST differ from
# JWT_SECRET, and MUST differ between dev and prod (they currently share JWT_SECRET,
# so a shared value would make a dev ops token valid against production).
PLATFORM_JWT_SECRET=

# Licensing enforcement: off | log | enforce. Ship 'log' (records would-be denials
# without acting), read the logs, then flip to 'enforce'.
LICENSE_ENFORCEMENT=log

# ── Observability (app/core/observability.py) ────────────────────────────────
# Bearer token a Prometheus scraper must send to read /metrics. Deliberately no
# default: unset means the endpoint answers 503 rather than serving openly, the
# same stance PLATFORM_JWT_SECRET takes. Generate one per environment.
METRICS_TOKEN=

# 'json' emits one JSON object per log line for ingestion; anything else keeps
# the human-readable format. Both carry the request id.
LOG_FORMAT=text

# Optional error reporting. Left blank, Sentry is not initialised at all and the
# SDK is not required — it is not in requirements.txt.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Tenant authentication. Replace this example before starting the API.
JWT_SECRET=replace-with-a-random-local-signing-secret

# AI decisions and exchange rates
OPENAI_DECISION_API=
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_DECISIONS_URL=https://api.openai.com/v1/decisions
FX_PRIMARY_SOURCE_URL=https://open.er-api.com/v6/latest/INR
FX_FALLBACK_API_KEY=
FX_FETCH_CURRENCIES=USD,EUR,GBP,JPY,AED,SGD,AUD,CAD
FX_BACKFILL_DAYS=90

# Google mailbox OAuth. Use the same redirect URI in the provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:8014/api/oauth/email/callback
APP_RETURN_URL=http://127.0.0.1:5174
EMAIL_TOKEN_KEY=

# Nova billing. Use the existing encryption key for previously stored credentials.
NOVA_BILLING_BASE_URL=https://api.lendix.ai
NOVA_KEY_ENCRYPTION_KEY=
NOVA_API_KEY__BRIGHTLOANS=
NOVA_API_KEY__VIMANOTECH=
NOVA_API_KEY__KREETIBUDDHA=
NOVA_ORCHESTRATOR_MIN_INVOICE_DATE=

# Disbursement. Set provider values for your test account.
DISBURSEMENT_BASE_URL=
DISBURSEMENT_API_KEY=
DISBURSEMENT_NBFC_NAME=
DISBURSEMENT_AUBANK_NBFC_NAME=
DISBURSEMENT_AUBANK_REMITTER_ACCOUNT=
DISBURSEMENT_DEMO_OTP=
DISBURSEMENT_FORCE_SUCCESS=false

# S3 document storage
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
